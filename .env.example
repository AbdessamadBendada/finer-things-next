# Copy to .env.local for development. Every value is optional; the defaults
# are what the project runs with out of the box. Parsed and validated by
# src/shared/config/env.ts, which fails the boot if anything is wrong.

# Canonical origin. Used for canonical URLs, Open Graph and the sitemap.
# Defaults to http://localhost:3000. There is no production default on purpose:
# the client's real domain is not confirmed yet, and a plausible-looking guess
# would ship silently. Set this to the confirmed origin before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image pipeline: default (Next optimizer) | cloudflare | unoptimized
NEXT_PUBLIC_IMAGE_LOADER=default

# Where contact enquiries go: log (records the event, delivers nothing) | noop
# | resend (real email). See docs/FORMS.md.
FORM_PROVIDER=log

# Required when FORM_PROVIDER=resend. The site refuses to boot without them.
# RESEND_API_KEY=re_xxx
# ENQUIRY_TO=studio@example.com
# ENQUIRY_FROM=Finer Things <studio@example.com>
#
# ENQUIRY_FROM defaults to Resend's sandbox sender, which only delivers to the
# address the Resend account was opened with. A real sender needs the
# production domain verified at resend.com/domains. That is not checked at
# boot, because only Resend knows which domains are verified, so it is the one
# setting that can be wrong and still start.

# Where newsletter subscriptions go: log | noop | mailerlite.
# Deliberately a separate switch from FORM_PROVIDER: an enquiry can go live as
# soon as a mailbox exists, a subscription cannot until consent and double
# opt-in do. See docs/adr/0002-deferred-compliance.md.
NEWSLETTER_PROVIDER=log

# Required when NEWSLETTER_PROVIDER=mailerlite.
# MAILERLITE_API_KEY=eyJ...
# MAILERLITE_GROUP_ID=1234567890
#
# Enable double opt-in *for API and integrations* in MailerLite. Without it,
# subscribers are created as unconfirmed and no confirmation is ever sent, so
# nobody joins and nothing looks broken.

# Bot protection strategy. Deferred to the Cloudflare edge; see
# docs/adr/0003-deferred-bot-protection.md
BOT_PROTECTION=noop
